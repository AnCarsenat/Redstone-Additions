# Current values on the Ender Vaults page.
#
# Records which page this is, so an action can redraw it afterwards. Per
# player, because two operators can be on different pages at once.
scoreboard players set @s ra.settings.apage 2

tellraw @s [{text:"─── ",color:"dark_gray"},{text:"Ender Vaults",color:"gold",bold:true},{text:" ───",color:"dark_gray"}]
