# Current values on the Logic Gates page.
tellraw @s [{text:"─── ",color:"dark_gray"},{text:"Logic Gates",color:"gold",bold:true},{text:" ───",color:"dark_gray"}]
tellraw @s [{text:"  Clock interval: ",color:"white"},{nbt:"global.props.\"clock\".\"cooldown\"",storage:"ra:settings",color:"aqua"}]
tellraw @s [{text:"  Delayer delay: ",color:"white"},{nbt:"global.props.\"delayer\".\"delay\"",storage:"ra:settings",color:"aqua"}]
tellraw @s [{text:"  Extender duration: ",color:"white"},{nbt:"global.props.\"extender\".\"extend\"",storage:"ra:settings",color:"aqua"}]
tellraw @s [{text:"  Shortener pulse: ",color:"white"},{nbt:"global.props.\"shortener\".\"pulse\"",storage:"ra:settings",color:"aqua"}]
tellraw @s [{text:"  Randomizer chance %: ",color:"white"},{nbt:"global.props.\"randomizer\".\"chance\"",storage:"ra:settings",color:"aqua"}]
execute unless data storage ra:settings disabled[{b:"uni_gate"}] run tellraw @s [{text:"  Universal Gate: ",color:"white"},{text:"enabled",color:"green"}]
execute if data storage ra:settings disabled[{b:"uni_gate"}] run tellraw @s [{text:"  Universal Gate: ",color:"white"},{text:"disabled",color:"red"}]
execute unless data storage ra:settings disabled[{b:"clock"}] run tellraw @s [{text:"  Clock: ",color:"white"},{text:"enabled",color:"green"}]
execute if data storage ra:settings disabled[{b:"clock"}] run tellraw @s [{text:"  Clock: ",color:"white"},{text:"disabled",color:"red"}]
execute unless data storage ra:settings disabled[{b:"delayer"}] run tellraw @s [{text:"  Delayer: ",color:"white"},{text:"enabled",color:"green"}]
execute if data storage ra:settings disabled[{b:"delayer"}] run tellraw @s [{text:"  Delayer: ",color:"white"},{text:"disabled",color:"red"}]
execute unless data storage ra:settings disabled[{b:"extender"}] run tellraw @s [{text:"  Extender: ",color:"white"},{text:"enabled",color:"green"}]
execute if data storage ra:settings disabled[{b:"extender"}] run tellraw @s [{text:"  Extender: ",color:"white"},{text:"disabled",color:"red"}]
execute unless data storage ra:settings disabled[{b:"shortener"}] run tellraw @s [{text:"  Shortener: ",color:"white"},{text:"enabled",color:"green"}]
execute if data storage ra:settings disabled[{b:"shortener"}] run tellraw @s [{text:"  Shortener: ",color:"white"},{text:"disabled",color:"red"}]
execute unless data storage ra:settings disabled[{b:"randomizer"}] run tellraw @s [{text:"  Randomizer: ",color:"white"},{text:"enabled",color:"green"}]
execute if data storage ra:settings disabled[{b:"randomizer"}] run tellraw @s [{text:"  Randomizer: ",color:"white"},{text:"disabled",color:"red"}]
