# Every operator settings page, as buttons.
#
# Three to a line rather than one page per line: the index is the first thing
# an operator sees and a column of eleven entries pushes the rest of chat off
# the screen before they have read any of it.
tellraw @s [{text:"─── ",color:"dark_gray"},{text:"Redstone Additions — Server Settings",color:"gold",bold:true},{text:" ───",color:"dark_gray"}]
tellraw @s [{text:"[Chunk Loader]",color:"yellow",bold:true,hover_event:{action:"show_text",value:"Open Chunk Loader"},click_event:{action:"run_command",command:"/function ra_settings:admin/chunk_loader/show"}},{text:" "},{text:"[Ender Vaults]",color:"yellow",bold:true,hover_event:{action:"show_text",value:"Open Ender Vaults"},click_event:{action:"run_command",command:"/function ra_settings:admin/ender/show"}},{text:" "},{text:"[Logic Gates]",color:"yellow",bold:true,hover_event:{action:"show_text",value:"Open Logic Gates"},click_event:{action:"run_command",command:"/function ra_settings:admin/gates/show"}}]
