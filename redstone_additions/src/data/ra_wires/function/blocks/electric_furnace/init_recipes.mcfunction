# /ra_wires:blocks/electric_furnace/init_recipes
# What the Electric Furnace can smelt, keyed by input item id.
#
# A data pack cannot ask the game what a vanilla smelting recipe produces, so
# this is a hand-maintained table. Keyed rather than listed for the same reason
# fuel_map is: the furnace's question is "is THIS thing smeltable?", asked once
# per stack it looks at, not "which of ninety recipes is in there?".
#
# Deliberately NOT exhaustive in one direction: results that are themselves
# smeltable are the thing to be careful with, because the furnace draws from and
# returns to the same block when it has nowhere else to put things. Stone is the
# one real chain here (cobblestone -> stone -> smooth_stone) and it is kept
# because smooth stone is a thing people want; the input/output slot split is
# what stops it running away.
#
# Unguarded, like every other registry in this pack, so an update to the table
# reaches worlds that already exist.

data modify storage ra:wires smelt_map set value {"minecraft:raw_iron":{result:"minecraft:iron_ingot"},"minecraft:raw_gold":{result:"minecraft:gold_ingot"},"minecraft:raw_copper":{result:"minecraft:copper_ingot"},"minecraft:iron_ore":{result:"minecraft:iron_ingot"},"minecraft:deepslate_iron_ore":{result:"minecraft:iron_ingot"},"minecraft:gold_ore":{result:"minecraft:gold_ingot"},"minecraft:deepslate_gold_ore":{result:"minecraft:gold_ingot"},"minecraft:copper_ore":{result:"minecraft:copper_ingot"},"minecraft:deepslate_copper_ore":{result:"minecraft:copper_ingot"},"minecraft:nether_gold_ore":{result:"minecraft:gold_ingot"},"minecraft:ancient_debris":{result:"minecraft:netherite_scrap"},"minecraft:coal_ore":{result:"minecraft:coal"},"minecraft:deepslate_coal_ore":{result:"minecraft:coal"},"minecraft:diamond_ore":{result:"minecraft:diamond"},"minecraft:deepslate_diamond_ore":{result:"minecraft:diamond"},"minecraft:emerald_ore":{result:"minecraft:emerald"},"minecraft:deepslate_emerald_ore":{result:"minecraft:emerald"},"minecraft:lapis_ore":{result:"minecraft:lapis_lazuli"},"minecraft:deepslate_lapis_ore":{result:"minecraft:lapis_lazuli"},"minecraft:redstone_ore":{result:"minecraft:redstone"},"minecraft:deepslate_redstone_ore":{result:"minecraft:redstone"},"minecraft:nether_quartz_ore":{result:"minecraft:quartz"},"minecraft:iron_sword":{result:"minecraft:iron_nugget"},"minecraft:iron_pickaxe":{result:"minecraft:iron_nugget"},"minecraft:iron_axe":{result:"minecraft:iron_nugget"},"minecraft:iron_shovel":{result:"minecraft:iron_nugget"},"minecraft:iron_hoe":{result:"minecraft:iron_nugget"},"minecraft:iron_helmet":{result:"minecraft:iron_nugget"},"minecraft:iron_chestplate":{result:"minecraft:iron_nugget"},"minecraft:iron_leggings":{result:"minecraft:iron_nugget"},"minecraft:iron_boots":{result:"minecraft:iron_nugget"},"minecraft:chainmail_helmet":{result:"minecraft:iron_nugget"},"minecraft:chainmail_chestplate":{result:"minecraft:iron_nugget"},"minecraft:chainmail_leggings":